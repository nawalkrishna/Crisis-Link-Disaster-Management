{
  "name": "crisislink",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Disaster-relief coordination platform for Kerala: camps, evacuees, volunteers, needs and donations.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @crisislink/api\" \"npm run dev -w @crisislink/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @crisislink/api",
    "db:seed": "npm run db:seed -w @crisislink/api",
    "db:reset": "npm run db:reset -w @crisislink/api",
    "db:studio": "npm run db:studio -w @crisislink/api",
    "make-admin": "npm run make-admin -w @crisislink/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
