// CrisisLink data model.
//
// Compared with the 2024 Firestore version:
// - one `Evacuee` table instead of one collection per district ('kannur', 'wayanad' ...)
// - rows get generated IDs, so two people called "Rahul" no longer overwrite each other
// - relations (camp -> district, need -> camp, donation -> need) are enforced by the database
//   with foreign keys, so you cannot reference a camp that doesn't exist
// - passwords are never stored: only an argon2id hash (the 2024 version stored them in plain text)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------- Geography ----------

model District {
  id                 Int                 @id @default(autoincrement())
  slug               String              @unique
  name               String              @unique
  camps              ReliefCamp[]
  incidents          IncidentReport[]
  volunteers         VolunteerProfile[]
  tasks              VolunteerTask[]
  alertSubscriptions AlertSubscription[]

  @@map("districts")
}

// ---------- Relief camps ----------

enum CampStatus {
  OPEN
  FULL
  CLOSED
}

model ReliefCamp {
  id           String     @id @default(uuid(7)) @db.Uuid
  name         String
  address      String
  districtId   Int        @map("district_id")
  district     District   @relation(fields: [districtId], references: [id])
  capacity     Int
  status       CampStatus @default(OPEN)
  contactName  String?    @map("contact_name")
  contactPhone String?    @map("contact_phone")
  latitude     Float?
  longitude    Float?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  evacuees     Evacuee[]
  needs        CampNeed[]
  donations    Donation[]
  coordinators CampCoordinator[]
  tasks        VolunteerTask[]

  // An index makes "all camps in district X" fast once there are thousands of rows.
  @@index([districtId])
  // Lets "camps near me" narrow down by a lat/lng range before computing exact distances.
  @@index([latitude, longitude])
  @@map("relief_camps")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

/// A person staying in a relief camp (called "inmate" in the 2024 version).
model Evacuee {
  id           String     @id @default(uuid(7)) @db.Uuid
  campId       String     @map("camp_id") @db.Uuid
  camp         ReliefCamp @relation(fields: [campId], references: [id], onDelete: Cascade)
  fullName     String     @map("full_name")
  age          Int?
  gender       Gender     @default(UNDISCLOSED)
  phone        String?
  homeAddress  String?    @map("home_address")
  medicalNotes String?    @map("medical_notes")
  checkedInAt  DateTime   @default(now()) @map("checked_in_at")
  /// null while the person is still in the camp.
  checkedOutAt DateTime?  @map("checked_out_at")

  @@index([campId, checkedOutAt])
  @@map("evacuees")
}

// ---------- Needs & donations ----------

enum SupplyCategory {
  FOOD
  WATER
  MEDICINE
  CLOTHING
  HYGIENE
  BEDDING
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NeedStatus {
  OPEN
  FULFILLED
  CANCELLED
}

/// Something a camp is asking for, e.g. "200 x drinking water bottles".
model CampNeed {
  id                String         @id @default(uuid(7)) @db.Uuid
  campId            String         @map("camp_id") @db.Uuid
  camp              ReliefCamp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  item              String
  category          SupplyCategory
  quantityNeeded    Int            @map("quantity_needed")
  quantityFulfilled Int            @default(0) @map("quantity_fulfilled")
  unit              String         @default("units")
  priority          Priority       @default(MEDIUM)
  status            NeedStatus     @default(OPEN)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  donations Donation[]

  @@index([status, priority])
  @@index([campId])
  @@map("camp_needs")
}

enum DonationStatus {
  PLEDGED
  RECEIVED
  CANCELLED
}

model Donation {
  id         String         @id @default(uuid(7)) @db.Uuid
  donorName  String         @map("donor_name")
  donorPhone String?        @map("donor_phone")
  category   SupplyCategory
  item       String
  quantity   Int
  status     DonationStatus @default(PLEDGED)
  /// Optional: the specific need this donation answers. Camp is derived from it.
  needId     String?        @map("need_id") @db.Uuid
  need       CampNeed?      @relation(fields: [needId], references: [id], onDelete: SetNull)
  campId     String?        @map("camp_id") @db.Uuid
  camp       ReliefCamp?    @relation(fields: [campId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @map("created_at")
  receivedAt DateTime?      @map("received_at")

  @@index([needId])
  @@index([campId])
  @@map("donations")
}

// ---------- Incidents ----------

enum IncidentType {
  FLOOD
  LANDSLIDE
  FIRE
  BUILDING_COLLAPSE
  ROAD_BLOCKED
  MEDICAL_EMERGENCY
  OTHER
}

enum IncidentStatus {
  REPORTED
  VERIFIED
  RESOLVED
  DISMISSED
}

model IncidentReport {
  id            String         @id @default(uuid(7)) @db.Uuid
  type          IncidentType
  severity      Priority
  status        IncidentStatus @default(REPORTED)
  description   String
  locationText  String         @map("location_text")
  districtId    Int            @map("district_id")
  district      District       @relation(fields: [districtId], references: [id])
  latitude      Float?
  longitude     Float?
  reporterName  String?        @map("reporter_name")
  reporterPhone String?        @map("reporter_phone")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  smsMessages SmsMessage[]

  @@index([status, severity])
  @@index([districtId])
  @@map("incident_reports")
}

// ---------- Accounts & access control ----------

/// What a user is allowed to do. Checked in apps/api/src/auth/policies.ts.
enum Role {
  ADMIN // runs the platform: creates camps, approves volunteers, assigns coordinators
  COORDINATOR // manages the camps they are assigned to
  VOLUNTEER // claims and completes tasks
}

enum AccountStatus {
  PENDING // registered, waiting for approval
  ACTIVE
  SUSPENDED // cannot log in; existing sessions stop working
}

model User {
  id           String        @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-case so "Asha@X.com" and "asha@x.com" are the same account.
  email        String        @unique
  fullName     String        @map("full_name")
  phone        String?
  /// argon2id hash - includes its own random salt and parameters.
  passwordHash String        @map("password_hash")
  role         Role          @default(VOLUNTEER)
  status       AccountStatus @default(PENDING)
  lastLoginAt  DateTime?     @map("last_login_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  sessions         Session[]
  volunteerProfile VolunteerProfile?
  coordinatedCamps CampCoordinator[]
  assignedTasks    VolunteerTask[]   @relation("TaskAssignee")
  createdTasks     VolunteerTask[]   @relation("TaskCreator")

  @@index([role, status])
  @@map("users")
}

/// A logged-in browser. The cookie holds a random token; we store only its SHA-256 hash,
/// so someone who reads the database still cannot impersonate users.
model Session {
  /// SHA-256 hash of the session token (hex).
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ip         String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum VolunteerSkill {
  FIRST_AID
  MEDICAL
  DRIVING
  COOKING
  SWIMMING_RESCUE
  COUNSELLING
  LOGISTICS
  TRANSLATION
  OTHER
}

/// Extra details for users who volunteer (one-to-one with User).
model VolunteerProfile {
  userId     String           @id @map("user_id") @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId Int              @map("district_id")
  district   District         @relation(fields: [districtId], references: [id])
  hometown   String?
  skills     VolunteerSkill[]
  available  Boolean          @default(true)

  @@index([districtId, available])
  @@map("volunteer_profiles")
}

/// Which coordinator manages which camp (many-to-many join table).
model CampCoordinator {
  userId     String     @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campId     String     @map("camp_id") @db.Uuid
  camp       ReliefCamp @relation(fields: [campId], references: [id], onDelete: Cascade)
  assignedAt DateTime   @default(now()) @map("assigned_at")

  @@id([userId, campId])
  @@index([campId])
  @@map("camp_coordinators")
}

// ---------- Volunteer tasks ----------

/// Allowed moves are enforced in apps/api/src/routes/tasks.ts (a small state machine):
/// OPEN -> ASSIGNED -> IN_PROGRESS -> DONE, and most states -> CANCELLED.
enum TaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model VolunteerTask {
  id            String          @id @default(uuid(7)) @db.Uuid
  title         String
  description   String
  priority      Priority        @default(MEDIUM)
  status        TaskStatus      @default(OPEN)
  requiredSkill VolunteerSkill? @map("required_skill")
  /// Optional: field tasks (e.g. a rescue) may not belong to a camp.
  campId        String?         @map("camp_id") @db.Uuid
  camp          ReliefCamp?     @relation(fields: [campId], references: [id], onDelete: SetNull)
  districtId    Int             @map("district_id")
  district      District        @relation(fields: [districtId], references: [id])
  assigneeId    String?         @map("assignee_id") @db.Uuid
  assignee      User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById   String          @map("created_by_id") @db.Uuid
  createdBy     User            @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  completedAt   DateTime?       @map("completed_at")

  @@index([status, districtId])
  @@index([assigneeId])
  @@index([campId])
  @@map("volunteer_tasks")
}

// ---------- Offline replays ----------

/// "Idempotency-Key" header records (see src/lib/idempotency.ts). A phone that was offline may
/// send the same request twice (once lost in a tunnel, once on reconnect): the second time we
/// return the stored response instead of creating a duplicate incident or check-in.
model IdempotencyKey {
  key         String   @id
  /// SHA-256 of method + path + user + body: reusing a key for a DIFFERENT request is an error.
  fingerprint String
  /// null while the first request is still running.
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------- SMS alerts ----------

/// A phone number that wants alerts for one district. Double opt-in: it only receives
/// alerts after proving it owns the number with a one-time code (OTP).
model AlertSubscription {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// E.164 format, e.g. +919400000001
  phone           String
  districtId      Int       @map("district_id")
  district        District  @relation(fields: [districtId], references: [id])
  verifiedAt      DateTime? @map("verified_at")
  /// SHA-256 of the current one-time code (never the code itself).
  otpHash         String?   @map("otp_hash")
  otpExpiresAt    DateTime? @map("otp_expires_at")
  otpAttempts     Int       @default(0) @map("otp_attempts")
  /// Random code in every alert's "stop" link.
  unsubscribeCode String    @unique @map("unsubscribe_code")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([phone, districtId])
  @@index([districtId, verifiedAt])
  @@map("alert_subscriptions")
}

enum SmsPurpose {
  OTP
  INCIDENT_ALERT
}

enum SmsStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

/// OUTBOX: messages are written here (in the same transaction as the change that causes them)
/// and a background worker sends them, retrying failures. See src/sms/worker.ts.
model SmsMessage {
  id            String          @id @default(uuid(7)) @db.Uuid
  to            String
  body          String
  purpose       SmsPurpose
  status        SmsStatus       @default(QUEUED)
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now()) @map("next_attempt_at")
  lastError     String?         @map("last_error")
  providerId    String?         @map("provider_id")
  incidentId    String?         @map("incident_id") @db.Uuid
  incident      IncidentReport? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  sentAt        DateTime?       @map("sent_at")

  /// Fan-out is idempotent: one phone never gets two alerts for the same incident.
  @@unique([incidentId, to])
  @@index([status, nextAttemptAt])
  @@index([to, purpose, createdAt])
  @@map("sms_messages")
}
