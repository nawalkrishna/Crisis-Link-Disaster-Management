# Copy this file to .env and adjust. .env is git-ignored - never commit real secrets.
NODE_ENV=development
PORT=4000
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://crisislink:change-me@localhost:5432/crisislink
# Comma-separated list of origins allowed to call the API from a browser
# (5173 = `npm run dev`, 4173 = `npm run preview` for testing the offline PWA build).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Session lifetime; active users are kept logged in (sliding expiry).
SESSION_TTL_DAYS=7
# Set to 1 when deployed behind one reverse proxy (most hosts), so rate limits see real client IPs.
TRUST_PROXY=0
# Development only: password for the sample users created by `npm run db:seed`
# (admin@ / coordinator@ / volunteer@ / pending@crisislink.test). Leave unset in production.
DEV_SEED_PASSWORD=change-me-dev-only
# Links inside SMS messages point here.
PUBLIC_WEB_URL=http://localhost:5173
# console = print SMS in this terminal (free, for development); twilio = send real SMS.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# Log verbosity: trace | debug | info | warn | error | fatal | silent (default: info).
# LOG_LEVEL=info
# Protects GET /metrics (Prometheus). Without it, metrics are off in production. 16+ characters.
# METRICS_TOKEN=
# Optional: share rate limits and live updates between several API servers.
# REDIS_URL=redis://localhost:6379
